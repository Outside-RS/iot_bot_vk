<%- include('partials/layout_start', { title: 'Рассылка', active: '/broadcast' }) %>

<div class="page-head">
    <div>
        <h1 class="page-title">Рассылка</h1>
        <div class="page-sub">Сообщение уходит всем выбранным пользователям бота</div>
    </div>
</div>

<div class="alert alert-warning">
    Отправка идёт постепенно, около 20 сообщений в секунду, чтобы ВКонтакте не заблокировал сообщество.
    Отменить начатую рассылку нельзя.
</div>

<div class="card" style="max-width:860px">
    <form action="/broadcast/send" method="POST" data-confirm="Отправить сообщение выбранным пользователям?">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">

        <div class="form-group">
            <label>Кому отправить</label>
            <div class="form-row">
                <label class="btn btn-ghost" style="flex:1 1 160px; justify-content:flex-start; gap:10px">
                    <input type="radio" name="target" value="all" checked style="width:auto;min-height:auto"> Всем
                </label>
                <label class="btn btn-ghost" style="flex:1 1 160px; justify-content:flex-start; gap:10px">
                    <input type="radio" name="target" value="students" style="width:auto;min-height:auto"> Студентам
                </label>
                <label class="btn btn-ghost" style="flex:1 1 160px; justify-content:flex-start; gap:10px">
                    <input type="radio" name="target" value="tutors" style="width:auto;min-height:auto"> Администраторам
                </label>
                <label class="btn btn-ghost" style="flex:1 1 160px; justify-content:flex-start; gap:10px">
                    <input type="radio" name="target" value="group" style="width:auto;min-height:auto"> Одной группе
                </label>
            </div>
        </div>

        <div class="form-group" id="groupInput" hidden>
            <label>Номер группы</label>
            <input type="text" name="group_number" placeholder="РИ-140944">
        </div>

        <div class="form-group">
            <label>От имени сообщества</label>
            <select name="vk_group_id">
                <% if (groups && groups.length > 0) { %>
                    <% groups.forEach(function (g) { %>
                        <option value="<%= g.group_id %>"><%= g.group_name %></option>
                    <% }); %>
                <% } else { %>
                    <option value="">Нет подключённых сообществ</option>
                <% } %>
            </select>
        </div>

        <div class="form-group">
            <label>Текст сообщения</label>
            <textarea name="message" rows="7" placeholder="Уважаемые студенты…" required></textarea>
        </div>

        <button type="submit" class="btn btn-warning" style="width:100%">🚀 Отправить рассылку</button>
    </form>
</div>

<script>
    // Поле «номер группы» показываем только для рассылки одной группе (CSP: без onclick)
    document.addEventListener('DOMContentLoaded', () => {
        const field = document.getElementById('groupInput');
        document.querySelectorAll('input[name="target"]').forEach(radio => {
            radio.addEventListener('change', () => { field.hidden = radio.value !== 'group'; });
        });
    });
</script>

<%- include('partials/layout_end') %>

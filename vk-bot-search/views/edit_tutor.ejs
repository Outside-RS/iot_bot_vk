<!DOCTYPE html>
<html lang="ru">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Редактирование Тьютора — Админ-панель</title>
    <link rel="stylesheet" href="/css/admin.css">
</head>

<body>
    <!-- Навигация -->
    <nav class="nav">
        <a href="/" class="nav-brand">🤖 IOT Bot Admin</a>
        <div class="nav-links">
            <a href="/" class="nav-link">🏠 Главная</a>
            <a href="/faq" class="nav-link">📚 База знаний</a>
            <a href="/tutors" class="nav-link active">👨‍🏫 Тьюторы</a>
            <a href="/groups" class="nav-link">📌 Группы VK</a>
            <a href="/users" class="nav-link">👥 Пользователи</a>
            <a href="/broadcast" class="nav-link">📢 Рассылка</a>
        </div>
        <div class="nav-right">
            <a href="/logout" class="nav-logout">🚪 Выход</a>
        </div>
    </nav>

    <div class="container" style="max-width: 600px;">
        <h1 class="page-title">✏️ Редактирование доступа</h1>

        <div class="card">
            <form action="/tutors/edit/<%= tutor.code %>" method="POST">
                <div class="form-group">
                    <label>Код доступа (Нельзя изменить)</label>
                    <input type="text" value="<%= tutor.code %>" disabled style="opacity: 0.6; cursor: not-allowed;">
                </div>

                <div class="form-group">
                    <label>ФИО Тьютора</label>
                    <input type="text" name="name" value="<%= tutor.tutor_name %>" required>
                </div>

                <div class="form-group">
                    <label>Группы (через запятую)</label>
                    <input type="text" name="groups" value="<%= tutor.allowed_groups.join(', ') %>" required>
                </div>

                <div class="form-group">
                    <label>Макс. курс (группы выпускников удаляются)</label>
                    <input type="number" name="max_course" value="<%= tutor.max_course || 4 %>" min="1" max="6"
                        required>
                </div>

                <div style="display: flex; gap: 15px; margin-top: 20px;">
                    <button type="submit" class="btn btn-primary" style="background: var(--purple);">💾
                        Сохранить</button>
                    <a href="/tutors" class="btn btn-danger" style="text-decoration: none;">Отмена</a>
                </div>
            </form>
        </div>
    </div>
</body>

</html>
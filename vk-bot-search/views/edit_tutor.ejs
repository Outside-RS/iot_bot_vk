<%- include('partials/layout_start', { title: 'Изменение доступа', active: '/tutors' }) %>

<div class="page-head">
    <h1 class="page-title">Изменение доступа</h1>
</div>

<div class="card" style="max-width:620px">
    <form action="/tutors/edit/<%= tutor.code %>" method="POST">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="form-group">
            <label>Код доступа (изменить нельзя)</label>
            <input type="text" value="<%= tutor.code %>" disabled>
        </div>
        <div class="form-group">
            <label>Имя администратора</label>
            <input type="text" name="name" value="<%= tutor.admin_name %>" required autofocus>
        </div>
        <div class="head-actions" style="margin-top:6px">
            <button type="submit" class="btn btn-primary">💾 Сохранить</button>
            <a href="/tutors" class="btn btn-ghost">Отмена</a>
        </div>
    </form>
</div>

<%- include('partials/layout_end') %>

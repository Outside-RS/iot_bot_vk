<%- include('partials/layout_start', { title: 'Изменение вопроса', active: '/faq' }) %>

<div class="page-head">
    <h1 class="page-title">Вопрос №<%= item.id %></h1>
</div>

<div class="card" style="max-width:860px">
    <datalist id="faq-categories">
        <% categories.forEach(function (cat) { %><option value="<%= cat %>"><% }); %>
    </datalist>
    <form action="/faq/edit/<%= item.id %>" method="POST">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="form-row">
            <div class="form-group" style="flex:1 1 200px">
                <label>Категория</label>
                <input type="text" name="category" list="faq-categories" autocomplete="off" value="<%= item.category %>" required>
            </div>
            <div class="form-group" style="flex:2 1 320px">
                <label>Вопрос</label>
                <input type="text" name="question" value="<%= item.question %>" required>
            </div>
        </div>
        <div class="form-group">
            <label>Ответ</label>
            <textarea name="answer" rows="8" required><%= item.answer %></textarea>
        </div>
        <div class="form-group">
            <label>Ключевые слова <span class="hint">— фразы через запятую</span></label>
            <input type="text" name="keywords" value="<%= item.keywords || '' %>">
        </div>
        <div class="head-actions" style="margin-top:6px">
            <button type="submit" class="btn btn-primary">💾 Сохранить</button>
            <a href="/faq" class="btn btn-ghost">Отмена</a>
        </div>
    </form>
</div>

<%- include('partials/layout_end') %>

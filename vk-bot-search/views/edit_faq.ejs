<!DOCTYPE html>
<html lang="ru">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Редактирование вопроса — Админ-панель</title>
    <link rel="stylesheet" href="/css/admin.css">
</head>

<body>
    <!-- Навигация -->
    <nav class="nav">
        <a href="/" class="nav-brand">🤖 IOT Bot Admin</a>
        <div class="nav-links">
            <a href="/" class="nav-link">🏠 Главная</a>
            <a href="/faq" class="nav-link active">📚 База знаний</a>
            <a href="/tutors" class="nav-link">👨‍🏫 Администраторы</a>
            <a href="/groups" class="nav-link">📌 Группы VK</a>
            <a href="/users" class="nav-link">👥 Пользователи</a>
            <a href="/broadcast" class="nav-link">📢 Рассылка</a>
                    <a href="/feedback" class="nav-link<%= typeof currentRoute !== "undefined" && currentRoute === "/feedback" ? " active" : "" %>">⚠️ Жалобы</a>
</div>
        <div class="nav-right">
            <a href="/logout" class="nav-logout">🚪 Выход</a>
        </div>
    </nav>

    <div class="container" style="max-width: 800px;">
        <h1 class="page-title">✏️ Редактирование вопроса #<%= item.id %>
        </h1>

        <div class="card">
            <datalist id="faq-categories">
                <% categories.forEach(function(cat) { %>
                    <option value="<%= cat %>">
                <% }); %>
            </datalist>
            <form action="/faq/edit/<%= item.id %>" method="POST">
                <div class="form-row">
                    <div class="form-group" style="flex: 1;">
                        <label>Категория</label>
                        <input type="text" name="category" list="faq-categories" autocomplete="off" value="<%= item.category %>" required>
                    </div>
                    <div class="form-group" style="flex: 2;">
                        <label>Вопрос</label>
                        <input type="text" name="question" value="<%= item.question %>" required>
                    </div>
                </div>

                <div class="form-group">
                    <label>Ответ</label>
                    <textarea name="answer" rows="6" required><%= item.answer %></textarea>
                </div>

                <div class="form-group">
                    <label>Ключевые слова <small style="color: var(--text-muted);">— фразы через запятую</small></label>
                    <input type="text" name="keywords" value="<%= item.keywords || '' %>">
                </div>

                <div style="display: flex; gap: 15px; margin-top: 20px;">
                    <button type="submit" class="btn btn-warning">💾 Сохранить изменения</button>
                    <a href="/faq" class="btn btn-danger" style="text-decoration: none;">Отмена</a>
                </div>
            </form>
        </div>
    </div>
</body>

</html>
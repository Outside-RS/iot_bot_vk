<!DOCTYPE html>
<html lang="ru">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Вход — Админ-панель</title>
    <link rel="stylesheet" href="/css/admin.css">
</head>

<body>
    <div class="login-page">
        <form class="login-box" action="/login" method="POST">
            <h1>🤖 IOT Bot</h1>
            <div class="hint">Панель управления ботом ИОТ</div>

            <% if (error) { %>
                <div class="alert alert-error"><%= error %></div>
            <% } %>

            <div class="form-group">
                <label for="password">Пароль администратора</label>
                <input type="password" id="password" name="password" placeholder="Введите пароль" required autofocus>
            </div>

            <button type="submit" class="btn btn-primary" style="width:100%">Войти</button>
        </form>
    </div>
</body>

</html>

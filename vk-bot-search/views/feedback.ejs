<%- include('partials/layout_start', { title: 'Жалобы и отзывы', active: '/feedback' }) %>

<div class="page-head">
    <div>
        <h1 class="page-title">Жалобы и отзывы</h1>
        <div class="page-sub">Что студенты и администраторы пишут о работе бота</div>
    </div>
</div>

<%- include('partials/pager', { page, queryString, baseUrl: '/feedback', unit: 'записей' }) %>

<div class="table-wrap">
    <table>
        <thead>
            <tr>
                <th style="width:70px">№</th>
                <th class="nowrap" style="width:160px">Когда</th>
                <th style="width:220px">Кто</th>
                <th>Сообщение</th>
                <th class="nowrap" style="width:170px">Статус</th>
                <th class="nowrap" style="width:80px"></th>
            </tr>
        </thead>
        <tbody>
            <% if (feedbackList.length === 0) { %>
                <tr>
                    <td colspan="6" class="empty">
                        <span class="ico">📭</span>
                        Обращений пока нет
                    </td>
                </tr>
            <% } else { %>
                <% feedbackList.forEach(function (f) { %>
                    <tr>
                        <td class="mono">#<%= f.id %></td>
                        <td class="nowrap"><%= new Date(f.created_at).toLocaleString('ru-RU') %></td>
                        <td>
                            <span class="cell-main"><%= f.full_name || '— без имени —' %></span>
                            <span class="cell-sub">
                                <%= f.role === 'operator' ? 'администратор' : 'студент' %> ·
                                <a href="https://vk.com/id<%= f.vk_id %>" target="_blank" rel="noopener"><%= f.vk_id %></a>
                            </span>
                        </td>
                        <td style="white-space: pre-wrap"><%= f.text %></td>
                        <td>
                            <form method="POST" action="/feedback/status/<%= f.id %>">
                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                <select name="status" data-autosubmit>
                                    <option value="new" <%= f.status === 'new' ? 'selected' : '' %>>🟠 Новое</option>
                                    <option value="in_progress" <%= f.status === 'in_progress' ? 'selected' : '' %>>🔵 В работе</option>
                                    <option value="resolved" <%= f.status === 'resolved' ? 'selected' : '' %>>🟢 Решено</option>
                                </select>
                            </form>
                        </td>
                        <td>
                            <form method="POST" action="/feedback/delete/<%= f.id %>" data-confirm="Удалить этот отзыв?">
                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                <button type="submit" class="icon-btn danger" title="Удалить">🗑</button>
                            </form>
                        </td>
                    </tr>
                <% }); %>
            <% } %>
        </tbody>
    </table>
</div>

<%- include('partials/pager', { page, queryString, baseUrl: '/feedback', unit: 'записей' }) %>

<%- include('partials/layout_end') %>

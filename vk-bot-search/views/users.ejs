<%- include('partials/layout_start', { title: 'Пользователи', active: '/users' }) %>

<div class="page-head">
    <div>
        <h1 class="page-title">Пользователи</h1>
        <div class="page-sub">Студенты и администраторы, зарегистрированные в боте</div>
    </div>
    <div class="head-actions">
        <form action="/users/promote-all" method="POST" data-confirm="Перевести ВСЕХ найденных по фильтру на следующий курс?">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <input type="hidden" name="course" value="<%= filter_course || '' %>">
            <input type="hidden" name="group" value="<%= filter_group || '' %>">
            <input type="hidden" name="role" value="<%= filter_role || '' %>">
            <button type="submit" class="btn btn-warning">🔼 Перевести всех на следующий курс</button>
        </form>
    </div>
</div>

<% if (typeof success !== 'undefined' && success) { %><div class="alert alert-success"><%= success %></div><% } %>
<% if (typeof error !== 'undefined' && error) { %><div class="alert alert-error"><%= error %></div><% } %>

<form class="card" method="GET" action="/users">
    <div class="toolbar">
        <div class="form-group grow">
            <label>Поиск по имени или VK ID</label>
            <input type="search" name="q" value="<%= search %>" placeholder="Кузнецова или 201000001">
        </div>
        <div class="form-group">
            <label>Курс</label>
            <select name="course">
                <option value="">Все курсы</option>
                <% [1,2,3,4,5,6].forEach(function (c) { %>
                    <option value="<%= c %>" <%= String(filter_course) === String(c) ? 'selected' : '' %>><%= c %> курс</option>
                <% }); %>
            </select>
        </div>
        <div class="form-group">
            <label>Группа</label>
            <input type="text" name="group" value="<%= filter_group || '' %>" placeholder="РИ-140944">
        </div>
        <div class="form-group">
            <label>Роль</label>
            <select name="role">
                <option value="">Все роли</option>
                <option value="student" <%= filter_role === 'student' ? 'selected' : '' %>>Студенты</option>
                <option value="operator" <%= filter_role === 'operator' ? 'selected' : '' %>>Администраторы</option>
            </select>
        </div>
        <div class="form-group">
            <label>Статус</label>
            <select name="graduated">
                <option value="">Все статусы</option>
                <option value="false" <%= filter_graduated === 'false' ? 'selected' : '' %>>Учатся</option>
                <option value="true" <%= filter_graduated === 'true' ? 'selected' : '' %>>Выпускники</option>
            </select>
        </div>
        <button type="submit" class="btn btn-primary">Найти</button>
        <% if (search || filter_course || filter_group || filter_role || filter_graduated) { %>
            <a href="/users" class="btn btn-ghost">Сбросить</a>
        <% } %>
    </div>
</form>

<%- include('partials/pager', { page, queryString, baseUrl: '/users', unit: 'человек' }) %>

<div class="table-wrap">
    <table>
        <thead>
            <tr>
                <th class="nowrap">VK ID</th>
                <th>Имя</th>
                <th class="nowrap">Группа</th>
                <th class="nowrap">Курс</th>
                <th class="nowrap">Роль</th>
                <th class="nowrap">Статус</th>
                <th class="nowrap" style="width:150px">Действия</th>
            </tr>
        </thead>
        <tbody>
            <% if (users.length === 0) { %>
                <tr>
                    <td colspan="7" class="empty">
                        <span class="ico">👤</span>
                        Никого не нашлось по этим условиям
                    </td>
                </tr>
            <% } else { %>
                <% users.forEach(function (u) {
                    const courseMatch = u.group_number ? u.group_number.match(/-(\d)/) : null;
                    const course = courseMatch ? courseMatch[1] : '—';
                %>
                    <tr>
                        <td class="nowrap"><a class="mono" href="https://vk.com/id<%= u.vk_id %>" target="_blank" rel="noopener"><%= u.vk_id %></a></td>
                        <td>
                            <span class="cell-main"><%= u.full_name || '— без имени —' %></span>
                            <% if (u.role === 'operator' && u.linked_code) { %>
                                <span class="cell-sub">код: <%= u.linked_code %></span>
                            <% } %>
                        </td>
                        <td class="nowrap"><%= u.group_number || '—' %></td>
                        <td class="nowrap"><%= course %></td>
                        <td class="nowrap">
                            <span class="badge <%= u.role === 'operator' ? 'badge-purple' : 'badge-info' %>">
                                <%= u.role === 'operator' ? 'Администратор' : 'Студент' %>
                            </span>
                        </td>
                        <td class="nowrap">
                            <% if (u.is_graduated) { %>
                                <span class="badge badge-warning">🎓 Выпускник</span>
                            <% } else { %>
                                <span class="badge badge-success">Учится</span>
                            <% } %>
                        </td>
                        <td>
                            <div class="row-actions">
                                <% if (!u.is_graduated) { %>
                                    <form action="/users/promote/<%= u.vk_id %>" method="POST">
                                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                        <button type="submit" class="icon-btn" title="Перевести на следующий курс">🔼</button>
                                    </form>
                                    <form action="/users/graduate/<%= u.vk_id %>" method="POST" data-confirm="Пометить как выпускника?">
                                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                        <button type="submit" class="icon-btn" title="Отметить выпускником">🎓</button>
                                    </form>
                                <% } %>
                                <form action="/users/delete/<%= u.vk_id %>" method="POST" data-confirm="Удалить пользователя? Он сможет зарегистрироваться заново.">
                                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                    <button type="submit" class="icon-btn danger" title="Удалить">🗑</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                <% }); %>
            <% } %>
        </tbody>
    </table>
</div>

<%- include('partials/pager', { page, queryString, baseUrl: '/users', unit: 'человек' }) %>

<%- include('partials/layout_end') %>

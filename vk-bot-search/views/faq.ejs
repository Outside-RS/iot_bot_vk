<!DOCTYPE html>
<html lang="ru">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>База Знаний — Админ-панель</title>
    <link rel="stylesheet" href="/css/admin.css">
</head>

<body>
    <!-- Toast Уведомление -->
    <div id="toast" class="toast-notification"></div>

    <!-- Навигация -->
    <nav class="nav">
        <a href="/" class="nav-brand">🤖 IOT Bot Admin</a>
        <div class="nav-links">
            <a href="/" class="nav-link">🏠 Главная</a>
            <a href="/faq" class="nav-link active">📚 База знаний</a>
            <a href="/tutors" class="nav-link">👨‍🏫 Администраторы</a>
            <a href="/groups" class="nav-link">📌 Группы VK</a>
            <a href="/users" class="nav-link">👥 Пользователи</a>
            <a href="/broadcast" class="nav-link">📢 Рассылка</a>
                    <a href="/feedback" class="nav-link<%= typeof currentRoute !== "undefined" && currentRoute === "/feedback" ? " active" : "" %>">⚠️ Жалобы</a>
</div>
        <div class="nav-right">
            <a href="/logout" class="nav-logout">🚪 Выход</a>
        </div>
    </nav>

    <div class="container">
        <h1 class="page-title">📚 База Знаний</h1>

        <% if (error) { %>
            <div class="alert alert-error">
                <%= error %>
            </div>
            <% } %>
                <% if (success) { %>
                    <div class="alert alert-success">
                        <%= success %>
                    </div>
                    <% } %>

                        <!-- Импорт из файла -->
                        <div class="card">
                            <div class="card-header">📥 Импорт из JSON-файла</div>
                            <div style="display: flex; align-items: center; gap: 12px; padding: 4px 0 8px;">
                                <input type="file" id="importFile" accept=".json" style="flex: 1;">
                                <button class="btn btn-primary" onclick="importFaq(this)" style="white-space: nowrap;">📥 Импортировать</button>
                            </div>
                            <div id="importResult" style="display: none; margin-top: 8px;"></div>
                        </div>

                        <!-- Форма добавления -->
                        <div class="card">
                            <div class="card-header">➕ Добавить новый вопрос</div>
                            <form action="/faq/add" method="POST">
                                <datalist id="faq-categories">
                                    <% categories.forEach(function(cat) { %>
                                        <option value="<%= cat %>">
                                    <% }); %>
                                </datalist>
                                <div class="form-row">
                                    <div class="form-group" style="flex: 1;">
                                        <label>Категория</label>
                                        <input type="text" name="category" list="faq-categories" autocomplete="off" placeholder="Например: Стипендия" required>
                                    </div>
                                    <div class="form-group" style="flex: 2;">
                                        <label>Вопрос студента</label>
                                        <input type="text" name="question"
                                            placeholder="Как получить социальную стипендию?" required>
                                    </div>
                                </div>

                                <div class="form-group">
                                    <label>Ответ бота</label>
                                    <textarea name="answer" rows="4"
                                        placeholder="Для получения социальной стипендии необходимо..."
                                        required></textarea>
                                </div>

                                <div class="form-group">
                                    <label>Ключевые слова <small style="color: var(--text-muted);">— фразы через запятую</small></label>
                                    <input type="text" name="keywords" placeholder="социальная стипендия, выплата, банковская карта">
                                </div>

                                <button type="submit" class="btn btn-success">💾 Сохранить</button>
                            </form>
                        </div>

                        <!-- Таблица FAQ -->
                        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 15px;">
                            <h2 style="color: var(--text-secondary);">Всего вопросов: <span id="faqVisibleCount"><%= faq.length %></span></h2>
                            <div style="display: flex; align-items: center; gap: 12px;">
                                <% if (categories.length > 0) { %>
                                <select id="categoryFilter" onchange="filterByCategory(this.value)" style="width: auto;">
                                    <option value="">Все категории</option>
                                    <% categories.forEach(function(cat) { %>
                                        <option value="<%= cat %>"><%= cat %></option>
                                    <% }); %>
                                </select>
                                <% } %>
                                <form action="/faq/export-json" method="POST" onsubmit="return confirm('Перезаписать faq_data.json данными из БД?');">
                                    <button type="submit" class="btn btn-warning" style="white-space: nowrap;">💾 Экспорт в файл</button>
                                </form>
                            </div>
                        </div>

                        <div class="table-container">
                            <table>
                                <thead>
                                    <tr>
                                        <th style="width: 5%;">ID</th>
                                        <th style="width: 12%;">Категория</th>
                                        <th style="width: 25%;">Вопрос</th>
                                        <th style="width: 48%;">Ответ</th>
                                        <th style="width: 10%;">Действия</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% if (faq.length===0) { %>
                                        <tr>
                                            <td colspan="5" class="empty-state">
                                                <div class="icon">📭</div>
                                                Нет вопросов в базе знаний
                                            </td>
                                        </tr>
                                        <% } else { %>
                                            <% faq.forEach(function(item) { %>
                                                <tr data-category="<%= item.category %>">
                                                    <td>
                                                        <%= item.id %>
                                                    </td>
                                                    <td><span class="badge badge-info">
                                                            <%= item.category %>
                                                        </span></td>
                                                    <td>
                                                        <b>
                                                            <%= item.question %>
                                                        </b>
                                                        <% if (item.keywords) { %>
                                                            <br><small style="color: var(--text-muted);">🔑 <%=
                                                                    item.keywords %></small>
                                                            <% } %>
                                                    </td>
                                                    <td><small>
                                                            <%= item.answer %>
                                                        </small></td>
                                                    <td class="actions">
                                                        <a href="/faq/edit/<%= item.id %>" class="action-btn edit"
                                                            title="Редактировать">✏️</a>
                                                        <form action="/faq/delete/<%= item.id %>" method="POST"
                                                            onsubmit="return confirm('Удалить этот вопрос?');"
                                                            style="display:inline;">
                                                            <button type="submit" class="action-btn delete"
                                                                title="Удалить">🗑</button>
                                                        </form>
                                                    </td>
                                                </tr>
                                                <% }); %>
                                                    <% } %>
                                </tbody>
                            </table>
                        </div>
    </div>

    <script>
        function filterByCategory(value) {
            const rows = document.querySelectorAll('tbody tr[data-category]');
            let visible = 0;
            rows.forEach(function(row) {
                const match = !value || row.dataset.category === value;
                row.style.display = match ? '' : 'none';
                if (match) visible++;
            });
            document.getElementById('faqVisibleCount').textContent = visible;
        }

        function showToast(message, type = 'success') {
            const toast = document.getElementById('toast');
            toast.textContent = message;
            toast.className = `toast-notification show ${type}`;
            setTimeout(() => {
                toast.className = toast.className.replace('show', '');
            }, 3000);
        }

        async function importFaq(btn) {
            const file = document.getElementById('importFile').files[0];
            if (!file) return alert('Выберите JSON-файл');

            let data;
            try {
                data = JSON.parse(await file.text());
            } catch (e) {
                return alert('Файл не является валидным JSON: ' + e.message);
            }

            if (!Array.isArray(data)) return alert('JSON должен быть массивом объектов.');

            btn.disabled = true;
            btn.textContent = '⏳ Импорт...';

            try {
                const res = await fetch('/faq/import-json', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(data)
                });
                const result = await res.json();

                if (result.success) {
                    showToast(`FAQ import: добавлено ${result.added}, обновлено ${result.updated}, пропущено ${result.skipped}`, 'success');
                    setTimeout(() => location.reload(), 2000);
                } else {
                    showToast('❌ ' + (result.error || 'Неизвестная ошибка'), 'error');
                }
            } catch (e) {
                showToast('Ошибка при отправке: ' + e.message, 'error');
            } finally {
                btn.disabled = false;
                btn.textContent = '📥 Импортировать';
            }
        }
    </script>
</body>

</html>
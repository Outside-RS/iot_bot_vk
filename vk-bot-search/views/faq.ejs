<%- include('partials/layout_start', { title: 'База знаний', active: '/faq' }) %>

<div class="page-head">
    <div>
        <h1 class="page-title">База знаний</h1>
        <div class="page-sub">Вопросы, по которым бот отвечает сам</div>
    </div>
    <div class="head-actions">
        <button class="btn btn-primary" id="addToggle">➕ Добавить вопрос</button>
        <a href="/faq/download-json" class="btn btn-ghost">⬇️ Скачать базу</a>
        <button class="btn btn-ghost" id="importToggle">📥 Импорт</button>
        <form action="/faq/export-json" method="POST" data-confirm="Перезаписать faq_data.json данными из базы?">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button type="submit" class="btn btn-ghost">💾 Экспорт в файл</button>
        </form>
    </div>
</div>

<% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>
<% if (success) { %><div class="alert alert-success"><%= success %></div><% } %>

<!-- Добавление вопроса: свёрнуто, чтобы список был виден сразу -->
<div class="card" id="addCard" hidden>
    <div class="card-head">➕ Новый вопрос</div>
    <form action="/faq/add" method="POST">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <datalist id="faq-categories">
            <% categories.forEach(function (cat) { %><option value="<%= cat %>"><% }); %>
        </datalist>
        <div class="form-row">
            <div class="form-group" style="flex:1 1 200px">
                <label>Категория</label>
                <input type="text" name="category" list="faq-categories" autocomplete="off" placeholder="Например: Стипендия" required>
            </div>
            <div class="form-group" style="flex:2 1 320px">
                <label>Вопрос студента</label>
                <input type="text" name="question" placeholder="Как получить социальную стипендию?" required>
            </div>
        </div>
        <div class="form-group">
            <label>Ответ бота</label>
            <textarea name="answer" rows="4" placeholder="Для получения социальной стипендии нужно…" required></textarea>
        </div>
        <div class="form-group">
            <label>Ключевые слова <span class="hint">— фразы через запятую, помогают поиску</span></label>
            <input type="text" name="keywords" placeholder="социальная стипендия, выплата, банковская карта">
        </div>
        <button type="submit" class="btn btn-success">💾 Сохранить</button>
    </form>
</div>

<!-- Импорт из файла -->
<div class="card" id="importCard" hidden>
    <div class="card-head">📥 Импорт из JSON-файла</div>
    <div class="toolbar">
        <div class="form-group grow">
            <label>Файл с вопросами</label>
            <input type="file" id="importFile" accept=".json">
        </div>
        <button class="btn btn-primary" id="importFaqBtn">📥 Импортировать</button>
    </div>
</div>

<!-- Поиск и фильтр -->
<form class="card" method="GET" action="/faq">
    <!-- Порядок сортировки сохраняем при поиске -->
    <input type="hidden" name="sort" value="<%= sort %>">
    <input type="hidden" name="dir" value="<%= direction %>">
    <div class="toolbar">
        <div class="form-group grow">
            <label>Поиск по вопросам, ответам и ключевым словам</label>
            <input type="search" name="q" value="<%= search %>" placeholder="стипендия, общежитие, пересдача…">
        </div>
        <div class="form-group">
            <label>Категория</label>
            <select name="category" data-autosubmit>
                <option value="">Все категории</option>
                <% categories.forEach(function (cat) { %>
                    <option value="<%= cat %>" <%= category === cat ? 'selected' : '' %>><%= cat %></option>
                <% }); %>
            </select>
        </div>
        <button type="submit" class="btn btn-primary">Найти</button>
        <% if (search || category) { %><a href="/faq" class="btn btn-ghost">Сбросить</a><% } %>
    </div>
</form>

<%- include('partials/pager', { page, queryString, baseUrl: '/faq', unit: 'вопросов' }) %>

<%
    // Ссылка для сортировки: повторное нажатие по той же колонке меняет направление
    function sortLink(field) {
        const next = (sort === field && direction === 'asc') ? 'desc' : 'asc';
        const params = new URLSearchParams();
        if (search) params.set('q', search);
        if (category) params.set('category', category);
        params.set('sort', field);
        params.set('dir', next);
        return '/faq?' + params.toString();
    }
    const arrow = (field) => sort === field ? (direction === 'asc' ? ' ▲' : ' ▼') : '';
%>
<div class="table-wrap">
    <table>
        <thead>
            <tr>
                <th style="width:80px"><a href="<%= sortLink('id') %>">№<%= arrow('id') %></a></th>
                <th style="width:160px"><a href="<%= sortLink('category') %>">Категория<%= arrow('category') %></a></th>
                <th style="width:30%">Вопрос</th>
                <th>Ответ</th>
                <th class="nowrap" style="width:120px"><a href="<%= sortLink('created_at') %>">Добавлен<%= arrow('created_at') %></a></th>
                <th class="nowrap" style="width:110px">Действия</th>
            </tr>
        </thead>
        <tbody>
            <% if (faq.length === 0) { %>
                <tr>
                    <td colspan="6" class="empty">
                        <span class="ico">📭</span>
                        <%= search || category ? 'Ничего не нашлось — измените запрос' : 'В базе знаний пока нет вопросов' %>
                    </td>
                </tr>
            <% } else { %>
                <% faq.forEach(function (item) { %>
                    <tr>
                        <td class="mono"><%= item.id %></td>
                        <td><span class="badge badge-info"><%= item.category %></span></td>
                        <td>
                            <span class="cell-main"><%= item.question %></span>
                            <% if (item.keywords) { %><span class="cell-sub">🔑 <%= item.keywords %></span><% } %>
                        </td>
                        <td><div class="clip"><%= item.answer %></div></td>
                        <td class="nowrap card-note">
                            <%= item.created_at
                                ? new Date(item.created_at).toLocaleDateString('ru-RU', { timeZone: 'Asia/Yekaterinburg', day: '2-digit', month: '2-digit', year: 'numeric' })
                                : '—' %>
                        </td>
                        <td>
                            <div class="row-actions">
                                <a href="/faq/edit/<%= item.id %>" class="icon-btn" title="Редактировать">✏️</a>
                                <form action="/faq/delete/<%= item.id %>" method="POST" data-confirm="Удалить этот вопрос?">
                                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                    <button type="submit" class="icon-btn danger" title="Удалить">🗑</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                <% }); %>
            <% } %>
        </tbody>
    </table>
</div>

<%- include('partials/pager', { page, queryString, baseUrl: '/faq', unit: 'вопросов' }) %>

<script>
    // Токен для изменяющих AJAX-запросов (см. CSRF-middleware в index.js)
    const csrfToken = document.querySelector('meta[name="csrf-token"]').content;

    async function importFaq(btn) {
        const file = document.getElementById('importFile').files[0];
        if (!file) return showToast('Выберите JSON-файл', 'error');

        let data;
        try {
            data = JSON.parse(await file.text());
        } catch (e) {
            return showToast('Файл не является правильным JSON: ' + e.message, 'error');
        }
        if (!Array.isArray(data)) return showToast('В файле должен быть массив объектов', 'error');

        btn.disabled = true;
        btn.textContent = '⏳ Импорт…';
        try {
            const res = await fetch('/faq/import-json', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': csrfToken },
                body: JSON.stringify(data)
            });
            const result = await res.json();
            if (!result.success) throw new Error(result.error || 'Неизвестная ошибка');
            showToast(`Добавлено ${result.added}, обновлено ${result.updated}, пропущено ${result.skipped}`);
            setTimeout(() => location.reload(), 1800);
        } catch (e) {
            showToast('Не удалось импортировать: ' + e.message, 'error');
        } finally {
            btn.disabled = false;
            btn.textContent = '📥 Импортировать';
        }
    }

    // Обработчики вынесены из атрибутов (CSP: script-src-attr 'none')
    document.addEventListener('DOMContentLoaded', () => {
        const toggle = (btn, card) => btn.addEventListener('click', () => {
            card.hidden = !card.hidden;
            if (!card.hidden) card.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        });
        toggle(document.getElementById('addToggle'), document.getElementById('addCard'));
        toggle(document.getElementById('importToggle'), document.getElementById('importCard'));
        const importBtn = document.getElementById('importFaqBtn');
        importBtn.addEventListener('click', () => importFaq(importBtn));
    });
</script>

<%- include('partials/layout_end') %>

<!DOCTYPE html>
<html lang="ru">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Группы VK — Админ-панель</title>
    <link rel="stylesheet" href="/css/admin.css">
    <style>
        .sync-bar { display: flex; justify-content: space-between; align-items: center; gap: 16px; margin: 18px 0 10px; flex-wrap: wrap; }
        .sync-hint { font-size: 13px; opacity: .7; max-width: 720px; line-height: 1.45; }
        .sync-time { font-size: 11px; opacity: .55; margin-top: 3px; white-space: nowrap; }
        .muted { opacity: .55; }
    </style>
</head>

<body>
    <!-- Навигация -->
    <nav class="nav">
        <a href="/" class="nav-brand">🤖 IOT Bot Admin</a>
        <div class="nav-links">
            <a href="/" class="nav-link">🏠 Главная</a>
            <a href="/faq" class="nav-link">📚 База знаний</a>
            <a href="/tutors" class="nav-link">👨‍🏫 Администраторы</a>
            <a href="/groups" class="nav-link active">📌 Группы VK</a>
            <a href="/users" class="nav-link">👥 Пользователи</a>
            <a href="/broadcast" class="nav-link">📢 Рассылка</a>
                    <a href="/feedback" class="nav-link<%= typeof currentRoute !== "undefined" && currentRoute === "/feedback" ? " active" : "" %>">⚠️ Жалобы</a>
            <a href="/logs" class="nav-link<%= typeof currentRoute !== "undefined" && currentRoute === "/logs" ? " active" : "" %>">💻 Логи</a>
</div>
        <div class="nav-right">
            <a href="/logout" class="nav-logout">🚪 Выход</a>
        </div>
    </nav>

    <div class="container">
        <h1 class="page-title">📌 Группы VK</h1>

        <% if (typeof error !=='undefined' && error) { %>
            <div class="alert alert-error">
                <%= error %>
            </div>
            <% } %>
                <% if (typeof success !=='undefined' && success) { %>
                    <div class="alert alert-success">
                        <%= success %>
                    </div>
                    <% } %>

                        <!-- Форма добавления -->
                        <div class="card">
                            <div class="card-header">➕ Добавить группу</div>
                            <form action="/groups/add" method="POST">
                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                <div class="form-row">
                                    <div class="form-group">
                                        <label>ID группы</label>
                                        <input type="number" name="group_id" placeholder="123456789" required>
                                    </div>
                                    <div class="form-group">
                                        <label>Токен сообщества</label>
                                        <input type="text" name="access_token" placeholder="vk1.a.xxx..." required>
                                    </div>
                                    <div class="form-group">
                                        <label>Название (опционально)</label>
                                        <input type="text" name="group_name" placeholder="Авто из VK">
                                    </div>
                                </div>
                                <button type="submit" class="btn btn-primary">Добавить</button>
                            </form>
                        </div>

                        <!-- Сверка названий с VK: курс берётся из названия сообщества -->
                        <div class="sync-bar">
                            <span class="sync-hint">Курс берётся из названия сообщества. Бот сверяет названия сам 1 августа и 1 сентября; при переименовании «Второй курс…» → «Третий курс…» студенты переводятся автоматически.</span>
                            <form action="/groups/sync-all" method="POST">
                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                <button type="submit" class="btn btn-sm">↻ Сверить все с VK</button>
                            </form>
                        </div>

                        <!-- Таблица групп -->
                        <div class="table-container">
                            <table>
                                <thead>
                                    <tr>
                                        <th>ID группы</th>
                                        <th>Название</th>
                                        <th>Курс</th>
                                        <th>Токен</th>
                                        <th>Статус</th>
                                        <th>Действия</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% if (groups.length===0) { %>
                                        <tr>
                                            <td colspan="6" class="empty-state">
                                                <div class="icon">📭</div>
                                                Нет подключенных групп
                                            </td>
                                        </tr>
                                        <% } else { %>
                                            <% groups.forEach(g=> { %>
                                                <tr>
                                                    <td>
                                                        <%= g.group_id %>
                                                    </td>
                                                    <td>
                                                        <%= g.group_name %>
                                                    </td>
                                                    <td>
                                                        <% if (g.is_archived) { %>
                                                            <span class="badge badge-warning">архив</span>
                                                        <% } else if (g.course) { %>
                                                            <strong><%= g.course %> курс</strong>
                                                        <% } else { %>
                                                            <span class="muted">не определён</span>
                                                        <% } %>
                                                        <div class="sync-time">
                                                            <%= g.name_synced_at ? 'сверено ' + new Date(g.name_synced_at).toLocaleString('ru-RU', { timeZone: 'Asia/Yekaterinburg', day: '2-digit', month: '2-digit', year: 'numeric', hour: '2-digit', minute: '2-digit' }) : 'ещё не сверялось с VK' %>
                                                        </div>
                                                    </td>
                                                    <td class="token-hidden">
                                                        <%= g.access_token.substring(0, 15) %>...
                                                    </td>
                                                    <td>
                                                        <span
                                                            class="badge <%= g.is_active ? 'badge-success' : 'badge-danger' %>">
                                                            <%= g.is_active ? 'Активна' : 'Отключена' %>
                                                        </span>
                                                    </td>
                                                    <td class="actions">
                                                        <form action="/groups/sync/<%= g.id %>" method="POST"
                                                            style="display:inline;">
                                                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                                            <button type="submit" class="btn btn-sm" title="Сверить название и курс с VK">↻</button>
                                                        </form>
                                                        <form action="/groups/toggle/<%= g.id %>" method="POST"
                                                            style="display:inline;">
                                                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                                            <button type="submit" class="btn btn-warning btn-sm">
                                                                <%= g.is_active ? '⏸ Откл' : '▶ Вкл' %>
                                                            </button>
                                                        </form>
                                                        <form action="/groups/delete/<%= g.id %>" method="POST"
                                                            style="display:inline;"
                                                            data-confirm="Удалить группу?" >
                                                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                                            <button type="submit" class="btn btn-danger btn-sm">🗑
                                                                Удалить</button>
                                                        </form>
                                                    </td>
                                                </tr>
                                                <% }); %>
                                                    <% } %>
                                </tbody>
                            </table>
                        </div>
    </div>
    <script src="/js/ui.js"></script>
</body>

</html>
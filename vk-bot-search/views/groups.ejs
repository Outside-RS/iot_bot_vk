<!DOCTYPE html>
<html lang="ru">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Группы VK</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', sans-serif;
            background: #1a1a2e;
            color: #eee;
            padding: 20px;
        }

        h1 {
            margin-bottom: 20px;
            color: #4fc3f7;
        }

        .container {
            max-width: 900px;
            margin: 0 auto;
        }

        /* Навигация */
        nav {
            margin-bottom: 30px;
        }

        nav a {
            color: #4fc3f7;
            text-decoration: none;
            margin-right: 20px;
            padding: 8px 16px;
            border-radius: 4px;
            transition: background 0.2s;
        }

        nav a:hover {
            background: rgba(79, 195, 247, 0.2);
        }

        /* Форма */
        .form-card {
            background: #16213e;
            padding: 20px;
            border-radius: 10px;
            margin-bottom: 30px;
        }

        .form-card h2 {
            margin-bottom: 15px;
            font-size: 1.1rem;
            color: #aaa;
        }

        .form-row {
            display: flex;
            gap: 10px;
            flex-wrap: wrap;
        }

        input[type="text"],
        input[type="number"] {
            flex: 1;
            min-width: 150px;
            padding: 10px 14px;
            border: none;
            border-radius: 6px;
            background: #0f3460;
            color: #fff;
            font-size: 14px;
        }

        input::placeholder {
            color: #666;
        }

        button {
            padding: 10px 20px;
            border: none;
            border-radius: 6px;
            cursor: pointer;
            font-weight: 600;
            transition: transform 0.1s, background 0.2s;
        }

        button:active {
            transform: scale(0.97);
        }

        .btn-add {
            background: #4fc3f7;
            color: #000;
        }

        .btn-add:hover {
            background: #81d4fa;
        }

        /* Таблица */
        table {
            width: 100%;
            border-collapse: collapse;
            background: #16213e;
            border-radius: 10px;
            overflow: hidden;
        }

        th,
        td {
            padding: 12px 15px;
            text-align: left;
            border-bottom: 1px solid #0f3460;
        }

        th {
            background: #0f3460;
            color: #4fc3f7;
            font-weight: 600;
        }

        tr:hover {
            background: rgba(79, 195, 247, 0.05);
        }

        /* Статус */
        .status {
            padding: 4px 10px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: 600;
        }

        .status-active {
            background: #2e7d32;
            color: #c8e6c9;
        }

        .status-inactive {
            background: #c62828;
            color: #ffcdd2;
        }

        /* Кнопки действий */
        .actions {
            display: flex;
            gap: 8px;
        }

        .btn-toggle {
            background: #ff9800;
            color: #000;
            font-size: 12px;
            padding: 6px 12px;
        }

        .btn-delete {
            background: #f44336;
            color: #fff;
            font-size: 12px;
            padding: 6px 12px;
        }

        /* Сообщения */
        .alert {
            padding: 12px 16px;
            border-radius: 6px;
            margin-bottom: 20px;
        }

        .alert-success {
            background: #2e7d32;
            color: #c8e6c9;
        }

        .alert-error {
            background: #c62828;
            color: #ffcdd2;
        }

        /* Токен (скрыт) */
        .token-hidden {
            font-family: monospace;
            color: #666;
        }
    </style>
</head>

<body>
    <div class="container">
        <nav>
            <a href="/">🏠 Главная</a>
            <a href="/faq">📚 База знаний</a>
            <a href="/tutors">👨‍🏫 Тьюторы</a>
            <a href="/groups">📌 Группы VK</a>
            <a href="/broadcast">📢 Рассылка</a>
            <a href="/logout">🚪 Выход</a>
        </nav>

        <h1>📌 Группы VK</h1>

        <% if (typeof error !=='undefined' && error) { %>
            <div class="alert alert-error">
                <%= error %>
            </div>
            <% } %>
                <% if (typeof success !=='undefined' && success) { %>
                    <div class="alert alert-success">
                        <%= success %>
                    </div>
                    <% } %>

                        <!-- Форма добавления -->
                        <div class="form-card">
                            <h2>➕ Добавить группу</h2>
                            <form action="/groups/add" method="POST">
                                <div class="form-row">
                                    <input type="number" name="group_id" placeholder="ID группы (например: 123456789)"
                                        required>
                                    <input type="text" name="access_token" placeholder="Токен сообщества" required>
                                    <input type="text" name="group_name" placeholder="Название (опционально)">
                                    <button type="submit" class="btn-add">Добавить</button>
                                </div>
                            </form>
                        </div>

                        <!-- Таблица групп -->
                        <table>
                            <thead>
                                <tr>
                                    <th>ID группы</th>
                                    <th>Название</th>
                                    <th>Токен</th>
                                    <th>Статус</th>
                                    <th>Действия</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% if (groups.length===0) { %>
                                    <tr>
                                        <td colspan="5" style="text-align: center; color: #666;">Нет подключенных групп
                                        </td>
                                    </tr>
                                    <% } else { %>
                                        <% groups.forEach(g=> { %>
                                            <tr>
                                                <td>
                                                    <%= g.group_id %>
                                                </td>
                                                <td>
                                                    <%= g.group_name %>
                                                </td>
                                                <td class="token-hidden">
                                                    <%= g.access_token.substring(0, 15) %>...
                                                </td>
                                                <td>
                                                    <span
                                                        class="status <%= g.is_active ? 'status-active' : 'status-inactive' %>">
                                                        <%= g.is_active ? 'Активна' : 'Отключена' %>
                                                    </span>
                                                </td>
                                                <td class="actions">
                                                    <form action="/groups/toggle/<%= g.id %>" method="POST"
                                                        style="display:inline;">
                                                        <button type="submit" class="btn-toggle">
                                                            <%= g.is_active ? '⏸ Откл' : '▶ Вкл' %>
                                                        </button>
                                                    </form>
                                                    <form action="/groups/delete/<%= g.id %>" method="POST"
                                                        style="display:inline;"
                                                        onsubmit="return confirm('Удалить группу?');">
                                                        <button type="submit" class="btn-delete">🗑 Удалить</button>
                                                    </form>
                                                </td>
                                            </tr>
                                            <% }); %>
                                                <% } %>
                            </tbody>
                        </table>
    </div>
</body>

</html>
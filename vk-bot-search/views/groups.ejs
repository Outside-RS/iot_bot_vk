<!DOCTYPE html>
<html lang="ru">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Группы VK — Админ-панель</title>
    <link rel="stylesheet" href="/css/admin.css">
</head>

<body>
    <!-- Навигация -->
    <nav class="nav">
        <a href="/" class="nav-brand">🤖 IOT Bot Admin</a>
        <div class="nav-links">
            <a href="/" class="nav-link">🏠 Главная</a>
            <a href="/faq" class="nav-link">📚 База знаний</a>
            <a href="/tutors" class="nav-link">👨‍🏫 Администраторы</a>
            <a href="/groups" class="nav-link active">📌 Группы VK</a>
            <a href="/users" class="nav-link">👥 Пользователи</a>
            <a href="/broadcast" class="nav-link">📢 Рассылка</a>
                    <a href="/feedback" class="nav-link<%= typeof currentRoute !== "undefined" && currentRoute === "/feedback" ? " active" : "" %>">⚠️ Жалобы</a>
            <a href="/logs" class="nav-link<%= typeof currentRoute !== "undefined" && currentRoute === "/logs" ? " active" : "" %>">💻 Логи</a>
</div>
        <div class="nav-right">
            <a href="/logout" class="nav-logout">🚪 Выход</a>
        </div>
    </nav>

    <div class="container">
        <h1 class="page-title">📌 Группы VK</h1>

        <% if (typeof error !=='undefined' && error) { %>
            <div class="alert alert-error">
                <%= error %>
            </div>
            <% } %>
                <% if (typeof success !=='undefined' && success) { %>
                    <div class="alert alert-success">
                        <%= success %>
                    </div>
                    <% } %>

                        <!-- Форма добавления -->
                        <div class="card">
                            <div class="card-header">➕ Добавить группу</div>
                            <form action="/groups/add" method="POST">
                                <div class="form-row">
                                    <div class="form-group">
                                        <label>ID группы</label>
                                        <input type="number" name="group_id" placeholder="123456789" required>
                                    </div>
                                    <div class="form-group">
                                        <label>Токен сообщества</label>
                                        <input type="text" name="access_token" placeholder="vk1.a.xxx..." required>
                                    </div>
                                    <div class="form-group">
                                        <label>Название (опционально)</label>
                                        <input type="text" name="group_name" placeholder="Авто из VK">
                                    </div>
                                </div>
                                <button type="submit" class="btn btn-primary">Добавить</button>
                            </form>
                        </div>

                        <!-- Таблица групп -->
                        <div class="table-container">
                            <table>
                                <thead>
                                    <tr>
                                        <th>ID группы</th>
                                        <th>Название</th>
                                        <th>Токен</th>
                                        <th>Статус</th>
                                        <th>Действия</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% if (groups.length===0) { %>
                                        <tr>
                                            <td colspan="5" class="empty-state">
                                                <div class="icon">📭</div>
                                                Нет подключенных групп
                                            </td>
                                        </tr>
                                        <% } else { %>
                                            <% groups.forEach(g=> { %>
                                                <tr>
                                                    <td>
                                                        <%= g.group_id %>
                                                    </td>
                                                    <td>
                                                        <%= g.group_name %>
                                                    </td>
                                                    <td class="token-hidden">
                                                        <%= g.access_token.substring(0, 15) %>...
                                                    </td>
                                                    <td>
                                                        <span
                                                            class="badge <%= g.is_active ? 'badge-success' : 'badge-danger' %>">
                                                            <%= g.is_active ? 'Активна' : 'Отключена' %>
                                                        </span>
                                                    </td>
                                                    <td class="actions">
                                                        <form action="/groups/toggle/<%= g.id %>" method="POST"
                                                            style="display:inline;">
                                                            <button type="submit" class="btn btn-warning btn-sm">
                                                                <%= g.is_active ? '⏸ Откл' : '▶ Вкл' %>
                                                            </button>
                                                        </form>
                                                        <form action="/groups/delete/<%= g.id %>" method="POST"
                                                            style="display:inline;"
                                                            onsubmit="return confirm('Удалить группу?');">
                                                            <button type="submit" class="btn btn-danger btn-sm">🗑
                                                                Удалить</button>
                                                        </form>
                                                    </td>
                                                </tr>
                                                <% }); %>
                                                    <% } %>
                                </tbody>
                            </table>
                        </div>
    </div>
</body>

</html>
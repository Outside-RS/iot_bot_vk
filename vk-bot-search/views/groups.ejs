<%- include('partials/layout_start', { title: 'Группы VK', active: '/groups' }) %>

<div class="page-head">
    <div>
        <h1 class="page-title">Группы VK</h1>
        <div class="page-sub">Сообщества, в которых работает бот</div>
    </div>
    <div class="head-actions">
        <form action="/groups/sync-all" method="POST">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button type="submit" class="btn btn-ghost">↻ Сверить все с VK</button>
        </form>
        <button class="btn btn-primary" id="addToggle">➕ Добавить сообщество</button>
    </div>
</div>

<% if (typeof error !== 'undefined' && error) { %><div class="alert alert-error"><%= error %></div><% } %>
<% if (typeof success !== 'undefined' && success) { %><div class="alert alert-success"><%= success %></div><% } %>

<div class="alert alert-warning" style="background:transparent">
    Курс берётся из названия сообщества. Бот сверяет названия сам 1 августа и 1 сентября:
    при переименовании «Второй курс…» → «Третий курс…» студенты переводятся автоматически.
</div>

<div class="card" id="addCard" hidden>
    <div class="card-head">➕ Новое сообщество</div>
    <form action="/groups/add" method="POST">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="form-row">
            <div class="form-group">
                <label>ID сообщества</label>
                <input type="text" name="group_id" inputmode="numeric" placeholder="234189923" required>
            </div>
            <div class="form-group" style="flex:2 1 300px">
                <label>Токен сообщества</label>
                <input type="text" name="access_token" placeholder="vk1.a.…" autocomplete="off" required>
            </div>
            <div class="form-group">
                <label>Название <span class="hint">— возьмётся из VK</span></label>
                <input type="text" name="group_name" placeholder="Можно не заполнять">
            </div>
        </div>
        <button type="submit" class="btn btn-success">Добавить</button>
    </form>
</div>

<div class="table-wrap">
    <table>
        <thead>
            <tr>
                <th class="nowrap">ID</th>
                <th>Название</th>
                <th class="nowrap">Курс</th>
                <th class="nowrap">Токен</th>
                <th class="nowrap">Статус</th>
                <th class="nowrap" style="width:160px">Действия</th>
            </tr>
        </thead>
        <tbody>
            <% if (groups.length === 0) { %>
                <tr>
                    <td colspan="6" class="empty">
                        <span class="ico">📭</span>
                        Сообщества не подключены
                    </td>
                </tr>
            <% } else { %>
                <% groups.forEach(function (g) { %>
                    <tr>
                        <td class="mono nowrap"><%= g.group_id %></td>
                        <td class="cell-main"><%= g.group_name %></td>
                        <td class="nowrap">
                            <% if (g.is_archived) { %>
                                <span class="badge badge-warning">архив</span>
                            <% } else if (g.course) { %>
                                <span class="badge badge-info"><%= g.course %> курс</span>
                            <% } else { %>
                                <span class="badge badge-muted">не определён</span>
                            <% } %>
                            <span class="cell-sub">
                                <%= g.name_synced_at
                                    ? 'сверено ' + new Date(g.name_synced_at).toLocaleString('ru-RU', { timeZone: 'Asia/Yekaterinburg', day: '2-digit', month: '2-digit', year: 'numeric', hour: '2-digit', minute: '2-digit' })
                                    : 'ещё не сверялось с VK' %>
                            </span>
                        </td>
                        <td class="mono nowrap"><%= g.access_token.substring(0, 12) %>…</td>
                        <td class="nowrap">
                            <span class="badge <%= g.is_active ? 'badge-success' : 'badge-danger' %>">
                                <%= g.is_active ? 'Работает' : 'Отключена' %>
                            </span>
                        </td>
                        <td>
                            <div class="row-actions">
                                <form action="/groups/sync/<%= g.id %>" method="POST">
                                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                    <button type="submit" class="icon-btn" title="Сверить название и курс с VK">↻</button>
                                </form>
                                <form action="/groups/toggle/<%= g.id %>" method="POST">
                                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                    <button type="submit" class="icon-btn" title="<%= g.is_active ? 'Отключить' : 'Включить' %>"><%= g.is_active ? '⏸' : '▶' %></button>
                                </form>
                                <form action="/groups/delete/<%= g.id %>" method="POST" data-confirm="Удалить сообщество? Бот перестанет отвечать в нём.">
                                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                    <button type="submit" class="icon-btn danger" title="Удалить">🗑</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                <% }); %>
            <% } %>
        </tbody>
    </table>
</div>

<script>
    // Обработчик вынесен из атрибута (CSP: script-src-attr 'none')
    document.addEventListener('DOMContentLoaded', () => {
        const card = document.getElementById('addCard');
        document.getElementById('addToggle').addEventListener('click', () => {
            card.hidden = !card.hidden;
            if (!card.hidden) card.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        });
    });
</script>

<%- include('partials/layout_end') %>

<!DOCTYPE html>
<html lang="ru">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Тьюторы — Админ-панель</title>
    <link rel="stylesheet" href="/css/admin.css">
</head>

<body>
    <!-- Навигация -->
    <nav class="nav">
        <a href="/" class="nav-brand">🤖 IOT Bot Admin</a>
        <div class="nav-links">
            <a href="/" class="nav-link">🏠 Главная</a>
            <a href="/faq" class="nav-link">📚 База знаний</a>
            <a href="/tutors" class="nav-link active">👨‍🏫 Тьюторы</a>
            <a href="/groups" class="nav-link">📌 Группы VK</a>
            <a href="/users" class="nav-link">👥 Пользователи</a>
            <a href="/broadcast" class="nav-link">📢 Рассылка</a>
        </div>
        <div class="nav-right">
            <a href="/logout" class="nav-logout">🚪 Выход</a>
        </div>
    </nav>

    <div class="container">
        <h1 class="page-title">👨‍🏫 Управление Тьюторами</h1>

        <!-- Форма добавления -->
        <div class="card">
            <div class="card-header">🔑 Создать новый код доступа</div>
            <form id="addTutorForm" autocomplete="off">
                <div class="form-row">
                    <div class="form-group">
                        <label>ФИО Тьютора</label>
                        <input type="text" name="name" placeholder="Иванов И.И." required>
                    </div>
                    <div class="form-group">
                        <label>Привязка к группам (через запятую)</label>
                        <input type="text" name="groups" placeholder="РИ-101, РИ-102" required>
                    </div>
                    <div class="form-group" style="flex: 0.5;">
                        <label>Макс. курс</label>
                        <input type="number" name="max_course" value="4" min="1" max="6" required>
                    </div>
                    <div class="form-group">
                        <label>Придумайте Код</label>
                        <input type="text" name="code" placeholder="SECRET-123" required>
                    </div>
                </div>
                <button type="submit" class="btn btn-primary" style="background: var(--purple);">Создать доступ</button>
            </form>
        </div>

        <!-- Таблица тьюторов -->
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 15px;">
            <h2 style="color: var(--text-secondary);">Активные коды: <%= tutors.length %>
            </h2>
        </div>

        <div class="table-container">
            <table>
                <thead>
                    <tr>
                        <th>Код доступа</th>
                        <th>ФИО Владельца</th>
                        <th>Группы</th>
                        <th>Макс. курс</th>
                        <th>Действия</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (tutors.length===0) { %>
                        <tr>
                            <td colspan="5" class="empty-state">
                                <div class="icon">👤</div>
                                Нет созданных кодов доступа
                            </td>
                        </tr>
                        <% } else { %>
                            <% tutors.forEach(function(t) { %>
                                <tr>
                                    <td><span class="badge badge-purple">
                                            <%= t.code %>
                                        </span></td>
                                    <td>
                                        <%= t.tutor_name %>
                                    </td>
                                    <td>
                                        <%= t.allowed_groups ? t.allowed_groups.join(', ') : '' %></td>
                                    <td><span class="badge badge-info"><%= t.max_course || 4 %></span></td>
                                <td class="actions">
                                    <a href="/tutors/edit/<%= t.code %>" class="action-btn edit" title="Редактировать">✏️</a>
                                    <form action="/tutors/delete/<%= t.code %>" method="POST" 
                                          onsubmit="return confirm(' Удалить?');" style="display:inline;">
                                            <button type="submit" class="action-btn delete" title="Удалить">🗑</button>
                                            </form>
                                    </td>
                                </tr>
                                <% }); %>
                                    <% } %>
                </tbody>
            </table>
        </div>
    </div>

    <script>
        document.getElementById('addTutorForm').addEventListener('submit', async function (e) {
            e.preventDefault();
            const formData = new URLSearchParams(new FormData(this));
            try {
                const response = await fetch('/tutors/add', {
                    method: 'POST',
                    body: formData
                });
                if (response.ok) {
                    window.location.replace('/tutors');
                } else {
                    alert('Ошибка при добавлении (возможно, такой код уже есть)');
                }
            } catch (error) {
                console.error('Error:', error);
                alert('Ошибка соединения');
            }
        });
    </script>
</body>

</html>
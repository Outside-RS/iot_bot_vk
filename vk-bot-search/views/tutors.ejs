<%- include('partials/layout_start', { title: 'Администраторы', active: '/tutors' }) %>

<div class="page-head">
    <div>
        <h1 class="page-title">Администраторы</h1>
        <div class="page-sub">Коды доступа: по ним человек становится администратором в боте</div>
    </div>
</div>

<div class="card">
    <div class="card-head">🔑 Новый код доступа</div>
    <form id="addTutorForm" autocomplete="off">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="form-row">
            <div class="form-group">
                <label>Имя администратора</label>
                <input type="text" name="name" placeholder="Алёна Смирнова" required>
            </div>
            <div class="form-group">
                <label>Код</label>
                <input type="text" name="code" placeholder="ALENA-2026" required>
            </div>
        </div>
        <div class="hint" style="margin-bottom:14px">
            Имя из кода попадает в профиль администратора и подставляется в сообщения студентам.
            Заводите отдельный код каждому — иначе не видно, кто взял вопрос.
        </div>
        <button type="submit" class="btn btn-primary">Создать доступ</button>
    </form>
</div>

<div class="table-wrap">
    <table>
        <thead>
            <tr>
                <th style="width:220px">Код доступа</th>
                <th>Имя администратора</th>
                <th class="nowrap" style="width:110px">Действия</th>
            </tr>
        </thead>
        <tbody>
            <% if (tutors.length === 0) { %>
                <tr>
                    <td colspan="3" class="empty">
                        <span class="ico">🔑</span>
                        Кодов доступа пока нет
                    </td>
                </tr>
            <% } else { %>
                <% tutors.forEach(function (t) { %>
                    <tr>
                        <td><span class="badge badge-purple mono"><%= t.code %></span></td>
                        <td class="cell-main"><%= t.admin_name %></td>
                        <td>
                            <div class="row-actions">
                                <a href="/tutors/edit/<%= t.code %>" class="icon-btn" title="Изменить имя">✏️</a>
                                <form action="/tutors/delete/<%= t.code %>" method="POST" data-confirm="Удалить код доступа? Те, кто уже вошёл по нему, останутся администраторами.">
                                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                    <button type="submit" class="icon-btn danger" title="Удалить">🗑</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                <% }); %>
            <% } %>
        </tbody>
    </table>
</div>

<script>
    document.getElementById('addTutorForm').addEventListener('submit', async function (e) {
        e.preventDefault();
        try {
            const response = await fetch('/tutors/add', {
                method: 'POST',
                body: new URLSearchParams(new FormData(this))
            });
            if (response.ok) return window.location.replace('/tutors');
            showToast('Не удалось создать код — возможно, такой уже есть', 'error');
        } catch (error) {
            showToast('Ошибка соединения: ' + error.message, 'error');
        }
    });
</script>

<%- include('partials/layout_end') %>

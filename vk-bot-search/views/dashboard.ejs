<!DOCTYPE html>
<html lang="ru">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Дашборд — Админ-панель</title>
    <link rel="stylesheet" href="/css/admin.css">
</head>

<body>
    <!-- Навигация -->
    <nav class="nav">
        <a href="/" class="nav-brand">🤖 IOT Bot Admin</a>
        <div class="nav-links">
            <a href="/" class="nav-link active">🏠 Главная</a>
            <a href="/faq" class="nav-link">📚 База знаний</a>
            <a href="/tutors" class="nav-link">👨‍🏫 Тьюторы</a>
            <a href="/groups" class="nav-link">📌 Группы VK</a>
            <a href="/users" class="nav-link">👥 Пользователи</a>
            <a href="/broadcast" class="nav-link">📢 Рассылка</a>
        </div>
        <div class="nav-right">
            <a href="/logout" class="nav-logout">🚪 Выход</a>
        </div>
    </nav>

    <div class="container">
        <h1 class="page-title">📊 Обзор системы</h1>

        <!-- Статистика -->
        <div class="stats-grid">
            <div class="stat-card">
                <h3>Обращений (Тикетов)</h3>
                <div class="stat-number">
                    <%= count %>
                </div>
            </div>
            <div class="stat-card">
                <h3>Активных ботов</h3>
                <div class="stat-number <%= botsCount > 0 ? 'success' : 'danger' %>">
                    <%= botsCount %>
                </div>
            </div>
            <div class="stat-card">
                <h3>Статус Ollama</h3>
                <div class="stat-number <%= ollamaStatus === 'Активна' ? 'success' : 'danger' %>"
                    style="font-size: 1.5rem;">
                    <%= ollamaStatus %>
                </div>
            </div>
        </div>

        <!-- Меню быстрого доступа -->
        <h2 style="color: var(--text-secondary); margin-bottom: 20px;">Быстрый доступ</h2>
        <div class="menu-grid">
            <a href="/faq" class="menu-item">
                <span class="icon">📚</span>
                <b>База Знаний</b>
                <p>Добавить/Удалить вопросы</p>
            </a>
            <a href="/tutors" class="menu-item">
                <span class="icon">👨‍🏫</span>
                <b>Тьюторы</b>
                <p>Управление доступом</p>
            </a>
            <a href="/groups" class="menu-item">
                <span class="icon">📌</span>
                <b>Группы VK</b>
                <p>Подключение сообществ</p>
            </a>
            <a href="/users" class="menu-item">
                <span class="icon">👥</span>
                <b>Пользователи</b>
                <p>Управление студентами</p>
            </a>
            <a href="/broadcast" class="menu-item">
                <span class="icon">📢</span>
                <b>Рассылка</b>
                <p>Написать всем</p>
            </a>
        </div>
    </div>
</body>

</html>
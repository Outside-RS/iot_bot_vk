<%- include('partials/layout_start', { title: 'Обзор', active: '/' }) %>

<div class="page-head">
    <div>
        <h1 class="page-title">Обзор системы</h1>
        <div class="page-sub">Состояние бота, ИИ-ассистента и резервных копий</div>
    </div>
    <div class="head-actions">
        <button class="btn btn-ghost" id="aiSettingsBtn">⚙️ Настройки ИИ</button>
    </div>
</div>

<% if (typeof testCodeActive !== 'undefined' && testCodeActive) { %>
    <div class="alert alert-warning">
        <strong>⚠️ Активен тестовый код доступа ADMIN-MAIN</strong>
        <p>
            Пока этот код существует, роль администратора в боте может получить любой, кто его введёт —
            код опубликован в исходниках проекта. Удалите его на странице
            <a href="/tutors">Администраторы</a>, когда заведёте рабочие коды.
        </p>
    </div>
<% } %>

<div class="grid grid-kpi">
    <div class="kpi">
        <div class="kpi-label">📨 Обращений студентов</div>
        <div class="kpi-value"><%= count %></div>
        <div class="kpi-note">Всего за всё время</div>
    </div>

    <div class="kpi">
        <div class="kpi-label">🤖 Ботов запущено</div>
        <div class="kpi-value <%= botsCount > 0 ? 'ok' : 'bad' %>"><%= botsCount %></div>
        <div class="kpi-note"><%= botsCount > 0 ? 'Сообщества отвечают' : 'Ни одно сообщество не подключено' %></div>
    </div>

    <div class="kpi">
        <div class="kpi-label">💾 Резервная копия</div>
        <% var b = typeof backup !== 'undefined' ? backup : null; %>
        <% if (!b) { %>
            <div class="kpi-value small bad">не настроена</div>
            <div class="kpi-note">Копии базы не делаются</div>
        <% } else { %>
            <div class="kpi-value small <%= b.ok && !b.stale ? 'ok' : 'bad' %>"><%= b.time %></div>
            <div class="kpi-note">
                <% if (!b.ok) { %>
                    Последняя попытка не удалась — смотрите журнал контейнера backup
                <% } else { %>
                    <%= b.size %><% if (b.sent === 'yes') { %>, копия на сервере<% } else if (b.sent === 'no') { %>, на сервер не ушла<% } else { %>, только на этом компьютере<% } %>
                    <% if (b.stale) { %><br>Копия старше двух суток<% } %>
                <% } %>
            </div>
        <% } %>
    </div>

    <div class="kpi">
        <div class="kpi-label">🧠 ИИ-ассистент</div>
        <div class="quota-row" style="margin-top: 10px;">
            <span class="status-dot <%= gigachatStatus === 'online' ? 'on' : 'off' %>"></span>
            <span style="flex:1">GigaChat</span>
            <span class="card-note"><%= gigachatModel %></span>
        </div>
        <div class="quota-row" style="margin-bottom: 0;">
            <span class="status-dot <%= ollamaStatus === 'online' ? 'on' : 'off' %>"></span>
            <span style="flex:1">Ollama</span>
            <span class="card-note"><%= ollamaModel %></span>
        </div>
    </div>
</div>

<h2 style="font-size:17px; margin: 26px 0 14px;">Быстрый доступ</h2>
<div class="grid grid-tiles">
    <a href="/faq" class="tile"><span class="ico">📚</span><b>База знаний</b><span>Вопросы и ответы бота</span></a>
    <a href="/tutors" class="tile"><span class="ico">👨‍🏫</span><b>Администраторы</b><span>Коды доступа</span></a>
    <a href="/groups" class="tile"><span class="ico">📌</span><b>Группы VK</b><span>Подключённые сообщества</span></a>
    <a href="/users" class="tile"><span class="ico">👥</span><b>Пользователи</b><span>Студенты и курсы</span></a>
    <a href="/broadcast" class="tile"><span class="ico">📢</span><b>Рассылка</b><span>Сообщение всем сразу</span></a>
    <a href="/logs" class="tile"><span class="ico">💻</span><b>Логи</b><span>Что происходило у бота</span></a>
</div>

<!-- Настройки ИИ -->
<div class="modal" id="aiModal">
    <div class="modal-box">
        <div class="modal-head">
            <span>⚙️ Настройки ИИ-ассистента</span>
            <button class="icon-btn" id="aiModalClose" aria-label="Закрыть">✕</button>
        </div>

        <div id="aiModalLoading" class="hint">Проверяем состояние моделей…</div>

        <div id="aiModalBody" hidden>
            <div class="card">
                <div class="card-head">
                    <span><span class="status-dot off" id="gigachatDot"></span> GigaChat (облако)</span>
                </div>
                <div class="form-group">
                    <label>Authorization Key</label>
                    <!-- autocomplete="new-password": без него браузер, помнящий пароль от
                         панели, подставляет его в это поле, и сохранение настроек
                         затирает им настоящий ключ GigaChat -->
                    <input type="password" id="gigachatKey" autocomplete="new-password"
                           placeholder="Вставьте Authorization Key">
                </div>
                <div class="form-row">
                    <div class="form-group">
                        <label>Scope</label>
                        <select id="gigachatScope">
                            <option value="GIGACHAT_API_PERS">GIGACHAT_API_PERS (физические лица)</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label>Модель</label>
                        <select id="gigachatModel">
                            <option value="GigaChat-2">GigaChat-2 (быстрая)</option>
                            <option value="GigaChat-2-Pro">GigaChat-2-Pro (продвинутая)</option>
                            <option value="GigaChat-2-Max">GigaChat-2-Max (максимальная)</option>
                        </select>
                    </div>
                </div>

                <div id="gigachatQuota" hidden>
                    <div class="card-head">
                        <span class="card-note">Расход токенов по классам моделей</span>
                        <button type="button" class="icon-btn" id="quotaRefreshBtn"
                                title="Сверить с личным кабинетом Сбера">↻</button>
                    </div>
                    <div id="quotaRows"></div>
                    <div class="card-note" id="quotaSync">Учёт бота. Нажмите ↻, чтобы сверить с личным кабинетом Сбера.</div>
                    <div class="card-note" style="margin-top:6px">
                        Во freemium-режиме квоты классов независимы: когда заканчивается один, бот сам переходит к следующему.
                    </div>
                </div>

                <div id="gigachatKeyInfo" hidden style="margin-top:14px">
                    <div class="quota-row">
                        <span style="flex:1">Текущий ключ: <code class="mono" id="gigachatMaskedKey"></code></span>
                        <button class="btn btn-danger btn-sm" id="deleteKeyBtn">Удалить ключ</button>
                    </div>
                    <div class="card-note">Оставьте поле пустым, чтобы сохранить текущий ключ.</div>
                </div>
            </div>

            <div class="card" style="margin-bottom:0">
                <div class="card-head">
                    <span><span class="status-dot off" id="ollamaDot"></span> Ollama (локальная модель)</span>
                </div>
                <div class="form-row">
                    <div class="form-group">
                        <label>Адрес сервера</label>
                        <input type="text" id="ollamaUrl" placeholder="http://127.0.0.1:11434">
                    </div>
                    <div class="form-group">
                        <label>Модель</label>
                        <select id="ollamaModel">
                            <option value="">Загрузка…</option>
                        </select>
                    </div>
                </div>
            </div>

            <div class="alert" id="aiSaveResult" hidden></div>

            <div class="modal-foot">
                <button class="btn btn-ghost" id="aiModalCancel">Отмена</button>
                <button class="btn btn-primary" id="saveAiBtn">💾 Сохранить</button>
            </div>
        </div>
    </div>
</div>

<script>
    // Токен для изменяющих AJAX-запросов (см. CSRF-middleware в index.js)
    const csrfToken = document.querySelector('meta[name="csrf-token"]').content;
    const $ = (id) => document.getElementById(id);

    function openAiModal() {
        $('aiModal').classList.add('open');
        $('aiModalLoading').hidden = false;
        $('aiModalBody').hidden = true;
        loadAiStatus();
    }

    function closeAiModal() {
        $('aiModal').classList.remove('open');
    }

    async function loadAiStatus() {
        try {
            const res = await fetch('/api/ai-status');
            const data = await res.json();

            $('ollamaDot').className = 'status-dot ' + (data.ollama.status === 'online' ? 'on' : 'off');
            $('ollamaUrl').value = data.ollama.url;

            const modelSelect = $('ollamaModel');
            modelSelect.replaceChildren();
            const models = data.ollama.models.length ? data.ollama.models : [data.ollama.model];
            models.forEach(m => {
                const opt = document.createElement('option');
                opt.value = m;
                opt.textContent = data.ollama.models.length ? m : m + ' (сервер не отвечает)';
                if (m === data.ollama.model) opt.selected = true;
                modelSelect.appendChild(opt);
            });

            $('gigachatDot').className = 'status-dot ' + (data.gigachat.status === 'configured' ? 'on' : 'off');
            $('gigachatScope').value = data.gigachat.scope;
            $('gigachatModel').value = data.gigachat.model;
            renderQuota(data.gigachat.usage || []);

            if (data.gigachat.maskedKey) {
                $('gigachatKeyInfo').hidden = false;
                $('gigachatMaskedKey').textContent = data.gigachat.maskedKey;
                $('gigachatKey').placeholder = 'Оставьте пустым, чтобы сохранить текущий';
            } else {
                $('gigachatKeyInfo').hidden = true;
                $('gigachatKey').placeholder = 'Вставьте Authorization Key';
            }

            $('aiModalLoading').hidden = true;
            $('aiModalBody').hidden = false;
        } catch (e) {
            $('aiModalLoading').textContent = 'Не удалось загрузить состояние: ' + e.message;
        }
    }

    // Отрисовка расхода квот. Значения приходят из базы, но собираем DOM
    // без innerHTML — единый подход после истории с XSS в логах.
    function renderQuota(usage) {
        const box = $('gigachatQuota');
        const rows = $('quotaRows');
        rows.replaceChildren();
        if (!usage.length) { box.hidden = true; return; }
        box.hidden = false;

        // Израсходовано — до тысячных миллиона (шаг 1000 токенов), квота — целыми
        const usedMln = n => (n / 1000000).toLocaleString('ru-RU', { minimumFractionDigits: 3, maximumFractionDigits: 3 }) + ' млн';
        const quotaMln = n => (n / 1000000).toLocaleString('ru-RU', { maximumFractionDigits: 3 }) + ' млн';

        for (const u of usage) {
            const row = document.createElement('div');
            row.className = 'quota-row';

            const name = document.createElement('span');
            name.className = 'name';
            name.textContent = u.modelId + (u.exhausted ? ' (исчерпан)' : '');

            const bar = document.createElement('div');
            bar.className = 'quota-bar';
            const fill = document.createElement('div');
            fill.className = 'quota-fill' + (u.percent >= 100 ? ' full' : (u.percent >= 80 ? ' warn' : ''));
            fill.style.width = Math.min(100, u.percent) + '%';
            bar.appendChild(fill);

            const val = document.createElement('span');
            val.className = 'quota-val';
            val.textContent = `${usedMln(u.used)} / ${quotaMln(u.quota)}`;
            val.title = `${u.used.toLocaleString('ru-RU')} из ${u.quota.toLocaleString('ru-RU')} токенов`;

            row.append(name, bar, val);
            rows.appendChild(row);
        }
    }

    // Сверка лимитов с личным кабинетом Сбера — только по нажатию, без опроса по таймеру
    async function refreshQuota() {
        const btn = $('quotaRefreshBtn');
        const status = $('quotaSync');
        btn.disabled = true;
        status.textContent = 'Запрашиваем баланс у Сбера…';
        try {
            const res = await fetch('/api/ai-balance/refresh', { method: 'POST', headers: { 'X-CSRF-Token': csrfToken } });
            const data = await res.json();
            if (!res.ok) throw new Error(data.error || `HTTP ${res.status}`);
            renderQuota(data.usage || []);
            status.textContent = '✓ Сверено с личным кабинетом Сбера в ' + new Date(data.syncedAt).toLocaleTimeString('ru-RU');
        } catch (e) {
            status.textContent = 'Не удалось получить баланс: ' + e.message;
        } finally {
            btn.disabled = false;
        }
    }

    function showResult(ok, text) {
        const box = $('aiSaveResult');
        box.className = 'alert ' + (ok ? 'alert-success' : 'alert-error');
        box.textContent = (ok ? '✅ ' : '❌ ') + text;
        box.hidden = false;
    }

    async function saveAiSettings() {
        const btn = $('saveAiBtn');
        btn.disabled = true;
        btn.textContent = '⏳ Сохранение…';
        try {
            const res = await fetch('/ai-settings', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': csrfToken },
                body: JSON.stringify({
                    ollama_url: $('ollamaUrl').value,
                    ollama_model: $('ollamaModel').value,
                    gigachat_key: $('gigachatKey').value,
                    gigachat_scope: $('gigachatScope').value,
                    gigachat_model: $('gigachatModel').value
                })
            });
            const data = await res.json();
            if (!data.success) throw new Error(data.error || 'Неизвестная ошибка');
            showResult(true, data.message);
            setTimeout(() => location.reload(), 1500);
        } catch (e) {
            showResult(false, e.message);
        } finally {
            btn.disabled = false;
            btn.textContent = '💾 Сохранить';
        }
    }

    async function deleteGigaChatKey() {
        if (!confirm('Удалить ключ GigaChat? Ответы через Сбер перестанут работать.')) return;
        try {
            const res = await fetch('/ai-settings/gigachat-key', { method: 'DELETE', headers: { 'X-CSRF-Token': csrfToken } });
            const data = await res.json();
            if (!data.success) throw new Error(data.error || 'Неизвестная ошибка');
            showResult(true, data.message);
            setTimeout(() => location.reload(), 1500);
        } catch (e) {
            showResult(false, e.message);
        }
    }

    // Обработчики вынесены из атрибутов (CSP: script-src-attr 'none')
    document.addEventListener('DOMContentLoaded', () => {
        $('aiSettingsBtn').addEventListener('click', openAiModal);
        $('aiModalClose').addEventListener('click', closeAiModal);
        $('aiModalCancel').addEventListener('click', closeAiModal);
        $('saveAiBtn').addEventListener('click', saveAiSettings);
        $('deleteKeyBtn').addEventListener('click', deleteGigaChatKey);
        $('quotaRefreshBtn').addEventListener('click', refreshQuota);
        $('aiModal').addEventListener('click', e => { if (e.target === $('aiModal')) closeAiModal(); });
    });
</script>

<%- include('partials/layout_end') %>

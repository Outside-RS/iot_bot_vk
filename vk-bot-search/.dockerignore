# Что НЕ копируется в образ при сборке (COPY . .)

# Секреты: контейнер получает их при запуске через env_file в docker-compose.yml,
# а вшитые в слой образа они остались бы там навсегда
.env
.env.*
!.env.example

# Туннель и HTTPS: в проде работают в отдельных контейнерах frpc и caddy
frpc.exe
frpc.toml
frpc.toml.example
Caddyfile

# Зависимости ставятся внутри образа под Linux (npm ci);
# локальные собраны под Windows и могут сломать сборку
node_modules
npm-debug.log

# Логи и рабочие файлы
logs
backups
backup
*.log
artifacts
tests

# Служебное
.git
.gitignore
Dockerfile
docker-compose.yml

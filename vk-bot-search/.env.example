# Шаблон настроек. Скопируйте в .env и заполните своими значениями.
# Сам .env в репозиторий не попадает (.gitignore) и в Docker-образ не копируется
# (.dockerignore) — контейнер получает его при запуске через env_file.

# ── База данных ─────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5433
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=

# ── Админка (обязательно — без них бот не запустится) ───────
# Пароль входа в веб-админку
ADMIN_PASS=
# Случайная длинная строка для подписи cookie сессии, например:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# ── HTTPS (только для docker-compose) ───────────────────────
# Публичный IP, по которому открывается админка, — IP VPS с frps.
# На него Caddy получает сертификат Let's Encrypt (см. Caddyfile).
PUBLIC_IP=
# acme — настоящий сертификат Let's Encrypt (прод);
# internal — собственный сертификат Caddy, браузер предупредит (проверка на своём ПК)
# TLS_MODE=acme

# ── GigaChat ────────────────────────────────────────────────
# Нужны только скриптам установки базы: при первом запуске ключ переносится
# в настройки ИИ в базе. Дальше ключ меняется в админке (карточка «ИИ-ассистент»).
GIGACHAT_AUTH_KEY=
GIGACHAT_SCOPE=GIGACHAT_API_PERS

# ── Локальная модель Ollama (резерв) ────────────────────────
# Так же, как ключ GigaChat: начальные значения, дальше — в админке
# OLLAMA_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=qwen3:8b

# ── Локальное тестирование (на проде НЕ задавать) ───────────
# Бот подключится только к перечисленным сообществам (ID через запятую),
# даже если в базе есть другие
# ALLOWED_GROUP_IDS=
# Запускать frpc.exe вместе с ботом (без Docker)
# ENABLE_FRPC=true

# ── Резервные копии базы (только для docker-compose) ────────
# Время ночной копии, часовой пояс берётся из LOG_TIMEZONE
# BACKUP_TIME=03:00
# Сколько дней хранить копии на этом компьютере (на сервере — 30 дней)
# BACKUP_KEEP_DAYS=14
# Сервер для второй копии. Пусто — копии только на этом компьютере.
# Обычно тот же VPS, что и в PUBLIC_IP
BACKUP_SSH_HOST=
# BACKUP_SSH_USER=botbackup
# BACKUP_SSH_PORT=22

# ── Логи (необязательно) ────────────────────────────────────
# debug — всё, включая подробности поиска; info — события и выше
# LOG_LEVEL=debug
# LOG_TIMEZONE=Asia/Yekaterinburg
# LOG_RETENTION_DAYS=14
# Папка для файлов логов (по умолчанию logs рядом с проектом)
# LOG_DIR=
# Запросы к базе дольше этого порога (мс) попадают в лог как медленные
# DB_SLOW_QUERY_MS=500
